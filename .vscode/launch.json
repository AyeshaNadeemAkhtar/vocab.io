{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask Backend",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/vocab.io-backend/app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "React Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/vocab.io-frontend"
    },
    {
      "name": "Chrome: Attach to React",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/vocab.io-frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack Debug",
      "configurations": ["Flask Backend", "React Dev Server", "Chrome: Attach to React"]
    }
  ]
}